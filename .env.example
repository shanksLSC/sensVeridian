# Veridian Studio API — environment (copy to .env)

# PostgreSQL (DuckDB -> Postgres migration target). The API uses the async URL;
# the worker derives the sync URL automatically (asyncpg -> psycopg).
DATABASE_URL=postgresql+asyncpg://veridian:veridian@localhost:5432/sensveridian

# Redis backs the face registry and (optionally) the arq ingest queue.
SV_REDIS_URL=redis://localhost:6379/0

# Allowed browser origins for the studio front-end.
VERIDIAN_CORS=http://localhost:5173,http://localhost:8000

# Media + frame storage (keep off /home, per repo convention).
VERIDIAN_MEDIA_ROOT=/data3/ssharma8/veridian/media
VERIDIAN_FRAMES_ROOT=/data3/ssharma8/veridian/frames

# Frame sampling: target fps for the OpenCV stride sampler + optional
# select_every_nth near-duplicate stride (1 = keep all decoded frames).
VERIDIAN_SAMPLE_FPS=2
VERIDIAN_DEDUP_STRIDE=1
VERIDIAN_JPEG_QUALITY=95

# Oracle weights / device — reuse sensveridian.config defaults if unset.
SV_MODELS_ROOT=/data3/ssharma8/all-models
SV_DEVICE=cuda
SV_FACE_MATCH_THRESHOLD=0.5

# Ingest queue: set to 1 to use the arq/Redis worker; unset = in-process dev.
VERIDIAN_USE_ARQ=

# Optional bearer token; when set, all /api/v1 routes require it.
VERIDIAN_AUTH_TOKEN=
